{
  "type": "action",
  "id": "tick",
  "steps": [
    {
      "type": "if",
      "condition": "{{ state.remaining > 1 }}",
      "then": [
        { "type": "state.increment", "path": "remaining", "value": "-1" }
      ],
      "else": [
        { "type": "state.set", "path": "remaining", "value": "{{ 0 }}" },
        { "type": "state.set", "path": "running", "value": "{{ false }}" },
        { "type": "invoke", "name": "finishCountdown" }
      ]
    }
  ]
}
