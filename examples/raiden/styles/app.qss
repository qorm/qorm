# Raiden 共享样式 —— 太空射击游戏的视觉风格

# HUD label (SCORE / LIVES)
.hudLabel { color: var(--textDim); fontSize: 10; fontWeight: 700 }

# HUD value
.hudValue { color: var(--accent); fontSize: 14; fontWeight: 700 }

# 触控按钮(◀ / FIRE / ▶ —— 手机端除滑动外的精确操控)
.ctrlBtn { background: var(--player); color: var(--text); borderRadius: 6; fontSize: 14; fontWeight: 700; padding: 8; width: 60 }

# Restart 按钮
.restartBtn { background: var(--accent); color: var(--space); borderRadius: 6; fontSize: 14; fontWeight: 700; padding: 10 }

# GAME OVER 覆盖面板
.deadPanel { background: var(--panel); borderRadius: 8; gap: 4 }
.deadTitle { color: var(--enemy); fontSize: 20; fontWeight: 800 }
.deadHint { color: var(--textDim); fontSize: 12 }