{
  "type": "scene",
  "id": "main",
  "root": {
    "type": "scroll",
    "id": "root",
    "style": { "background": "#F2F2F7", "height": "fill" },
    "children": [
      { "type": "text", "text": "Widget Showcase", "style": { "fontSize": 26, "fontWeight": 800, "padding": { "top": 24, "left": 20, "bottom": 8 } } },
      { "type": "text", "text": "Canvas native data/structure widgets", "style": { "fontSize": 13, "color": "#8E8E93", "padding": { "left": 20, "bottom": 20 } } },

      { "type": "text", "text": "MENU — dropdown trigger + items", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 8 } } },
      { "type": "menu", "id": "mn",
        "style": { "width": 200, "margin": { "left": 20 } },
        "props": { "label": "Actions", "items": [
          {"label":"Copy", "onPress":{"name":"menu_pick","args":{"value":"copy"}}},
          {"label":"Delete","onPress":{"name":"menu_pick","args":{"value":"delete"}}}
        ]}
      },
      { "type": "text", "text": "Picked: {{state.menuPicked}}", "if": "{{state.menuPicked}}", "style": { "fontSize": 12, "color": "#8E8E93", "padding": { "left": 20 } } },

      { "type": "text", "text": "SEGMENTED — option toggle", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "segmented", "id": "seg",
        "style": { "width": 300, "margin": { "left": 20 } },
        "value": "{{state.selectedSegment}}", "onChange": {"name":"set_segment"},
        "props": { "options": [{"value":"day","label":"Day"},{"value":"week","label":"Week"},{"value":"month","label":"Month"}] }
      },

      { "type": "text", "text": "ACCORDION — expand/collapse panels", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "accordion", "id": "ac",
        "style": { "width": 360, "margin": { "left": 20 } },
        "props": { "active": "{{state.accordionActive}}" },
        "children": [
          { "type": "box", "props": {"title":"General"}, "style": {"height":80}, "children": [
            {"type":"text","text":"App version: 2.1.0","style":{"fontSize":13,"color":"#1D1D1F"}},
            {"type":"text","text":"Build: 142 (production)","style":{"fontSize":13,"color":"#8E8E93","padding":{"top":4}}}
          ]},
          { "type": "box", "props": {"title":"Advanced"}, "style": {"height":60}, "children": [
            {"type":"text","text":"Cache: 24 MB / 128 MB","style":{"fontSize":13,"color":"#1D1D1F"}}
          ]}
        ]
      },

      { "type": "text", "text": "EXPANSION TILE  +  LIST SECTION", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "listsection", "id": "ls",
        "style": { "width": 360, "margin": { "left": 20 } },
        "props": { "header": "Recent Items" },
        "children": [
          { "type": "listtile", "props": {"title":"Project Alpha","subtitle":"Last edited 2h ago","leading":"📁"} },
          { "type": "listtile", "props": {"title":"Meeting notes","subtitle":"Shared by Carol","leading":"📝"} }
        ]
      },
      { "type": "expansiontile", "id": "et",
        "style": { "width": 360, "margin": { "left": 20, "top": 8 } },
        "props": { "title": "More details", "initiallyExpanded": false },
        "children": [
          { "type": "text", "text": "This content is hidden until the tile is expanded. Click the summary row to toggle.", "style": {"fontSize":13,"color":"#8E8E93"} }
        ]
      },

      { "type": "text", "text": "TABLE — bound data + sortable headers", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "table", "id": "tbl",
        "style": { "margin": { "left": 20 } },
        "data": "{{state.tableRows}}", "onChange": {"name":"sort_table"},
        "props": { "columns": [
          {"title":"Name","field":"name","width":120},
          {"title":"Score","field":"score","width":80},
          {"title":"Role","field":"role","width":100}
        ]}
      },

      { "type": "text", "text": "BREADCRUMB + STEPS + PAGINATION", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "breadcrumb", "id": "bc",
        "style": { "margin": { "left": 20 } },
        "props": { "items": ["Dashboard","Settings","Profile"] }
      },
      { "type": "steps", "id": "st",
        "style": { "margin": { "left": 20, "top": 12 }, "width": 400 },
        "props": { "steps": ["Order placed","Shipped","Delivered"], "active": 1 }
      },
      { "type": "pagination", "id": "pg",
        "style": { "margin": { "left": 20, "top": 12 } },
        "onPress": {"name":"nav_page"},
        "props": { "page": "{{state.currentPage}}", "total": 3 }
      },

      { "type": "text", "text": "TIMELINE — vertical track", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "timeline", "id": "tl",
        "style": { "margin": { "left": 20 }, "width": 400 },
        "props": { "items": "{{state.timelineItems}}" }
      },

      { "type": "text", "text": "BUTTONS + EMPTY", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "row", "style": { "gap": 12, "margin": { "left": 20 } }, "children": [
        { "type": "backbutton", "style": { "width": 44, "height": 44 } },
        { "type": "closebutton", "style": { "width": 44, "height": 44 } }
      ]},
      { "type": "empty", "id": "emp",
        "style": { "width": 300, "margin": { "left": 20, "top": 12 } },
        "props": { "title": "No items yet", "text": "Add your first item to get started" }
      },

      { "type": "text", "text": "DRAWER + NAVIGATION RAIL", "style": { "fontSize": 12, "fontWeight": 800, "color": "#8E8E93", "padding": { "left": 20, "top": 16 } } },
      { "type": "row", "style": { "gap": 12, "margin": { "left": 20 } }, "children": [
        { "type": "navigationrail", "id": "nr",
          "style": { "height": 200 },
          "value": "{{state.railSelected}}", "onChange": {"name":"rail_select"},
          "props": { "items": [
            {"value":"dashboard","label":"Home","icon":"🏠"},
            {"value":"search","label":"Search","icon":"🔍"},
            {"value":"settings","label":"Settings","icon":"⚙"}
          ]}
        },
        { "type": "drawer", "id": "dr",
          "props": { "open": "{{state.drawerOpen}}", "side": "right" },
          "children": [
            { "type": "button", "label": "Close Drawer", "onPress": {"name":"toggle_drawer","args":{"not":false}} }
          ]
        }
      ]},
      { "type": "button", "label": "Open Drawer", "onPress": {"name":"toggle_drawer","args":{"not":true}}, "style": {"margin":{"left":20,"top":8}} },

      { "type": "text", "text": "End of showcase", "style": { "fontSize": 12, "color": "#C7C7CC", "padding": { "left": 20, "top": 40, "bottom": 40 }, "textAlign": "center" } }
    ]
  }
}
