{
  "type": "scene",
  "id": "main",
  "root": {
    "type": "column",
    "id": "root",
    "style": {
      "background": "var(--background)",
      "padding": 32
    },
    "layout": {
      "width": "fill",
      "height": "fill",
      "align": "center",
      "justify": "center"
    },
    "children": [
      {
        "type": "text",
        "id": "title",
        "text": "COUNTER",
        "style": {
          "color": "var(--primary)",
          "fontSize": 14,
          "fontWeight": 700,
          "textAlign": "center"
        }
      },
      {
        "type": "animated_container",
        "id": "display",
        "style": {
          "margin": { "top": 40, "bottom": 40 },
          "padding": 20,
          "width": 300,
          "height": 160
        },
        "layout": {
          "align": "center"
        },
        "children": [
          {
            "type": "text",
            "id": "number",
            "text": "{{state.count}}",
            "style": {
              "fontSize": 80,
              "fontWeight": 900,
              "textAlign": "center"
            }
          },
          {
            "type": "text",
            "id": "status_text",
            "text": "{{state.status}}",
            "style": {
              "color": "var(--textSecondary)",
              "fontSize": 14,
              "margin": { "top": 8 }
            }
          }
        ]
      },
      {
        "type": "row",
        "id": "controls",
        "style": {
          "margin": { "top": 20 },
          "gap": 16
        },
        "layout": {
          "align": "center",
          "justify": "center"
        },
        "children": [
          {
            "type": "button",
            "id": "btn_decrement",
            "label": "Minus (-)",
            "onPress": {
              "name": "decrement"
            }
          },
          {
            "type": "button",
            "id": "btn_increment",
            "label": "Plus (+)",
            "onPress": {
              "name": "increment"
            }
          }
        ]
      },
      {
        "type": "button",
        "id": "btn_theme",
        "label": "Toggle Theme ({{state.theme}})",
        "style": {
          "margin": { "top": 40 }
        },
        "onPress": {
          "name": "toggle_theme"
        }
      }
    ]
  }
}
