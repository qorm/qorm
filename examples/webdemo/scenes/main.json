{
  "type": "scene",
  "id": "main",
  "root": {
    "type": "column",
    "id": "root",
    "style": {
      "background": "var(--background)",
      "padding": 24,
      "gap": 12
    },
    "layout": {
      "width": "fill",
      "height": "fill"
    },
    "children": [
      {
        "type": "text",
        "id": "title",
        "text": "Canvas + WKWebView",
        "style": {
          "color": "var(--label)",
          "fontSize": 20,
          "fontWeight": 700
        }
      },
      {
        "type": "webview",
        "id": "page",
        "html": "<!doctype html><html><body style=\"margin:0;font-family:-apple-system,sans-serif;background:#0d1117;color:#e6edf3;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh\"><h3 style=\"margin:0 0 8px\">WKWebView overlay</h3><p id=\"s\" style=\"margin:0 0 12px;color:#8b949e\">rendering…</p><button id=\"b\" style=\"padding:8px 16px;font-size:14px\">Call native bridge</button><script>document.getElementById('s').textContent='inline HTML in a real WKWebView';if(window.qormDesktop){window.qormDesktop(JSON.stringify({op:'probe',note:'webview-loaded'}));}function qormOnNetwork(j){document.getElementById('s').textContent='bridge reply: '+j;}document.getElementById('b').onclick=function(){if(window.qormDesktop){window.qormDesktop(JSON.stringify({op:'networkStatus'}));}};</script></body></html>",
        "style": {
          "width": 512,
          "height": 400
        }
      },
      {
        "type": "text",
        "id": "note",
        "text": "The box above is a real WKWebView subview over the canvas window in a -tags canvaswebview build, a bordered placeholder in the pure-Go build, and an <iframe> on the HTML renderer. Its page talks to Go through the qormDesktop JS bridge (the probe + button log to stderr / update in place).",
        "style": {
          "color": "var(--secondary-label)",
          "fontSize": 12
        }
      }
    ]
  }
}
