# TETRIS 共享样式 —— DOM+CSS+JS 三层分离的样式层:
# 结构在 scenes/*.json,逻辑在 actions/*.qs,通用样式集中在这里,
# 场景节点经 class 引用(后者覆盖前者,id 规则与行内 style 优先级更高)。

# 侧栏小标题(NEXT / SCORE / LINES / LEVEL)
.statLabel { color: var(--textSecondary); fontSize: 11; fontWeight: 700 }

# 侧栏数值(分数 / 行数 / 等级)
.statValue { color: var(--primary); fontSize: 16; fontWeight: 700 }

# 底部操作说明
.helpText { color: var(--textSecondary); fontSize: 12; textAlign: center }

# 暂停 / 结束覆盖层面板(padding/margin 是嵌套对象,留在场景行内)
.overlayPanel { background: var(--background); borderRadius: 8; gap: 2 }

# 覆盖层标题(PAUSED / GAME OVER)
.overlayTitle { color: var(--primary); fontSize: 13; fontWeight: 700 }

# 覆盖层提示行(P: resume / R: restart)
.overlayHint { color: var(--textSecondary); fontSize: 10 }
