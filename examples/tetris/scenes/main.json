{
  "type": "scene",
  "id": "main",
  "keys": {
    "left": "moveLeft",
    "right": "moveRight",
    "down": "moveDown",
    "up": "rotate",
    "x": "rotate",
    "z": "rotateCCW",
    "space": "hardDrop",
    "p": "togglePause",
    "r": "restart"
  },
  "root": {
    "type": "column",
    "id": "root",
    "style": {
      "background": "var(--background)",
      "padding": 24,
      "gap": 12
    },
    "layout": {
      "width": "fill",
      "height": "fill",
      "align": "center"
    },
    "children": [
      {
        "type": "timer",
        "id": "gravity",
        "every": "{{ 800 - (state.level - 1) * 70 < 250 ? 250 : 800 - (state.level - 1) * 70 }}",
        "onTick": "tick",
        "if": "{{ state.status == 'playing' }}"
      },
      {
        "type": "text",
        "id": "title",
        "text": "TETRIS",
        "animation": "fadeup",
        "duration": 400,
        "curve": "backOut",
        "style": {
          "color": "var(--primary)",
          "fontSize": 18,
          "fontWeight": 700,
          "textAlign": "center"
        }
      },
      {
        "type": "row",
        "id": "playarea",
        "style": {
          "gap": 16
        },
        "children": [
          {
            "type": "stack",
            "id": "boardstack",
            "style": {
              "background": "#0a0a10",
              "borderRadius": 8,
              "outlineColor": "{{ state.fxKind == 3 ? \"#f7d308\" : (state.fxKind == 2 ? \"#31c7ef\" : \"#333\") }}",
              "outlineWidth": 2,
              "outlineOffset": 2
            },
            "children": [
              {
                "type": "gridview",
                "id": "boardgrid",
                "data": "{{ state.view }}",
                "crossAxisCount": 10,
                "spacing": 1,
                "style": {
                  "gap": 1
                },
                "renderItem": {
                  "type": "box",
                  "style": {
                    "width": 16,
                    "height": 16,
                    "background": "{{ item == 0 ? \"#121218\" : (state.flashOn ? \"#ffffff\" : at(state.colorsLo, item)) }}"
                  },
                  "children": [
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 2,
                        "y": 2,
                        "width": 12,
                        "height": 12,
                        "background": "{{ state.flashOn ? \"#ffffff\" : at(state.colors, item) }}"
                      }
                    },
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 2,
                        "y": 2,
                        "width": 12,
                        "height": 3,
                        "background": "{{ state.flashOn ? \"#ffffff\" : at(state.colorsHi, item) }}"
                      }
                    },
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 2,
                        "y": 5,
                        "width": 3,
                        "height": 9,
                        "background": "{{ state.flashOn ? \"#ffffff\" : at(state.colorsHi, item) }}"
                      }
                    },
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 3,
                        "y": 3,
                        "width": 4,
                        "height": 2,
                        "background": "#ffffff"
                      }
                    }
                  ]
                }
              },
              {
                "type": "box",
                "id": "clearFlash",
                "if": "{{ state.flashOn }}",
                "style": {
                  "width": 169,
                  "height": 339,
                  "background": "{{ state.fxKind == 3 ? \"#f7d308\" : \"#ffffff\" }}",
                  "opacity": 0.18
                }
              },
              {
                "type": "text",
                "id": "clearBanner",
                "if": "{{ state.clearName != \"\" }}",
                "text": "{{ state.clearName }}",
                "animation": "pop",
                "duration": 380,
                "curve": "backOut",
                "fxToken": "{{ state.fxClear }}",
                "style": {
                  "width": 169,
                  "margin": { "top": 140 },
                  "fontSize": "{{ state.fxKind == 3 ? 22 : 16 }}",
                  "fontWeight": 800,
                  "textAlign": "center",
                  "color": "{{ state.fxKind == 3 ? \"#f7d308\" : \"#ffffff\" }}",
                  "textStrokeColor": "#000000",
                  "textStrokeWidth": 2
                }
              },
              {
                "type": "column",
                "layout": {
                  "align": "center"
                },
                "if": "{{ state.status == 'paused' }}",
                "class": "overlayPanel",
                "animation": "fade",
                "duration": 280,
                "style": {
                  "padding": {
                    "top": 10,
                    "bottom": 10,
                    "left": 14,
                    "right": 14
                  },
                  "margin": {
                    "top": 130
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "text": "PAUSED",
                    "class": "overlayTitle"
                  },
                  {
                    "type": "text",
                    "text": "P: resume",
                    "class": "overlayHint"
                  }
                ]
              },
              {
                "type": "column",
                "layout": {
                  "align": "center"
                },
                "if": "{{ state.status == 'over' }}",
                "class": "overlayPanel",
                "animation": "pop",
                "duration": 420,
                "curve": "backOut",
                "style": {
                  "padding": {
                    "top": 10,
                    "bottom": 10,
                    "left": 14,
                    "right": 14
                  },
                  "margin": {
                    "top": 130
                  }
                },
                "children": [
                  {
                    "type": "text",
                    "text": "GAME OVER",
                    "class": "overlayTitle"
                  },
                  {
                    "type": "text",
                    "text": "R: restart",
                    "class": "overlayHint"
                  }
                ]
              }
            ]
          },
          {
            "type": "column",
            "id": "sidebar",
            "style": {
              "gap": 6,
              "width": 100
            },
            "layout": {
              "justify": "space-between"
            },
            "children": [
              {
                "type": "text",
                "text": "NEXT",
                "class": "statLabel"
              },
              {
                "type": "gridview",
                "id": "nextgrid",
                "fx": "punch",
                "fxToken": "{{ state.fxSpawn }}",
                "fxDuration": 180,
                "fxIntensity": 0.12,
                "data": "{{ state.nextView }}",
                "crossAxisCount": 4,
                "spacing": 1,
                "style": {
                  "gap": 1,
                  "background": "#1c1c1c"
                },
                "layout": {
                  "alignSelf": "start"
                },
                "renderItem": {
                  "type": "box",
                  "style": {
                    "width": 12,
                    "height": 12,
                    "background": "{{ item == 0 ? \"#121218\" : at(state.colorsLo, item) }}"
                  },
                  "children": [
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 2,
                        "y": 2,
                        "width": 8,
                        "height": 8,
                        "background": "{{ at(state.colors, item) }}"
                      }
                    },
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 2,
                        "y": 2,
                        "width": 8,
                        "height": 2,
                        "background": "{{ at(state.colorsHi, item) }}"
                      }
                    },
                    {
                      "type": "box",
                      "if": "{{ item > 0 }}",
                      "style": {
                        "x": 2,
                        "y": 4,
                        "width": 2,
                        "height": 6,
                        "background": "{{ at(state.colorsHi, item) }}"
                      }
                    }
                  ]
                }
              },
              {
                "type": "text",
                "text": "SCORE",
                "class": "statLabel",
                "style": {
                  "margin": {
                    "top": 8
                  }
                }
              },
              {
                "type": "text",
                "id": "scoreVal",
                "text": "{{ state.score }}",
                "class": "statValue",
                "fx": "{{ state.fxClear > 0 ? \"punch\" : \"none\" }}",
                "fxToken": "{{ state.fxClear }}",
                "fxDuration": 220,
                "fxIntensity": 0.2
              },
              {
                "type": "text",
                "text": "LINES",
                "class": "statLabel",
                "style": {
                  "margin": {
                    "top": 8
                  }
                }
              },
              {
                "type": "text",
                "id": "linesVal",
                "text": "{{ state.lines }}",
                "class": "statValue",
                "fx": "{{ state.fxClear > 0 ? \"punch\" : \"none\" }}",
                "fxToken": "{{ state.fxClear }}",
                "fxDuration": 220
              },
              {
                "type": "text",
                "text": "LEVEL",
                "class": "statLabel",
                "style": {
                  "margin": {
                    "top": 8
                  }
                }
              },
              {
                "type": "text",
                "id": "levelVal",
                "text": "{{ state.level }}",
                "class": "statValue",
                "fx": "punch",
                "fxToken": "{{ state.level }}",
                "fxDuration": 240
              }
            ]
          }
        ]
      },
      {
        "type": "column",
        "id": "help",
        "style": {
          "gap": 2
        },
        "children": [
          {
            "type": "text",
            "text": "Left/Right/Down: move   Up/X: rotate   Z: rotate ccw",
            "class": "helpText"
          },
          {
            "type": "text",
            "text": "Space: hard drop   P: pause   R: restart",
            "class": "helpText"
          }
        ]
      }
    ]
  },
  "onEnter": "restart"
}