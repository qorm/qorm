{
  "type": "scene",
  "id": "main",
  "root": {
    "type": "scroll",
    "id": "stage",
    "style": {
      "width": "fill",
      "height": "fill",
      "background": "#0f1115",
      "padding": 16,
      "gap": 20
    },
    "layout": { "width": "fill", "height": "fill" },
    "children": [
      {
        "type": "column",
        "id": "body",
        "style": { "gap": 18, "width": "fill", "maxWidth": 360 },
        "layout": { "width": "fill" },
        "children": [
          {
            "type": "text",
            "id": "title",
            "text": "Canvas FX",
            "class": "title"
          },
          {
            "type": "text",
            "id": "subtitle",
            "text": "snap · mask · chrome · stack · skew · blend · qss · qs",
            "class": "subtitle"
          },

          {
            "type": "text",
            "id": "h_snap",
            "text": "1. Scroll snap (drag the pager)",
            "class": "heading"
          },
          {
            "type": "scroll",
            "id": "snap_strip",
            "class": "snapStrip",
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "box",
                "id": "page_a",
                "class": "snapPage",
                "style": { "background": "linear-gradient(180deg, #007aff, #5ac8fa)" },
                "children": [
                  {
                    "type": "text",
                    "text": "Page A — release to snap",
                    "style": { "fontSize": 18, "fontWeight": 800, "color": "#ffffff" }
                  }
                ]
              },
              {
                "type": "box",
                "id": "page_b",
                "class": "snapPage",
                "style": { "background": "linear-gradient(180deg, #34c759, #30d158)" },
                "children": [
                  {
                    "type": "text",
                    "text": "Page B",
                    "style": { "fontSize": 18, "fontWeight": 800, "color": "#ffffff" }
                  }
                ]
              },
              {
                "type": "box",
                "id": "page_c",
                "class": "snapPage",
                "style": { "background": "linear-gradient(180deg, #ff9f0a, #ffd60a)" },
                "children": [
                  {
                    "type": "text",
                    "text": "Page C",
                    "style": { "fontSize": 18, "fontWeight": 800, "color": "#1d1d1f" }
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_conic",
            "text": "2. Conic gradient + outline",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "conic_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "conic_disc",
                "role": "img",
                "ariaLabel": "Conic gradient color wheel",
                "style": {
                  "width": 96,
                  "height": 96,
                  "borderRadius": 48,
                  "background": "conic-gradient(from 0deg, #ff3b30, #ff9f0a, #34c759, #007aff, #af52de, #ff3b30)",
                  "outline": "3px solid #ffffff",
                  "outlineOffset": 4
                }
              },
              {
                "type": "column",
                "style": { "gap": 6, "flexGrow": 1 },
                "children": [
                  {
                    "type": "text",
                    "text": "conic-gradient medal",
                    "style": { "fontSize": 14, "fontWeight": 600, "color": "#ffffff" }
                  },
                  {
                    "type": "text",
                    "text": "outline sits outside the border box — focus-ring style without layout shift.",
                    "style": { "fontSize": 12, "color": "#9aa3b2", "lineClamp": 3, "width": 220 }
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_mask",
            "text": "3. Mask fade (edge dissolve)",
            "class": "heading"
          },
          {
            "type": "box",
            "id": "mask_panel",
            "style": {
              "width": "fill",
              "height": 88,
              "borderRadius": 12,
              "background": "linear-gradient(90deg, #5e5ce6, #bf5af2)",
              "padding": 14,
              "maskFade": "right",
              "maskFadeSize": 72
            },
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "text",
                "text": "Long row that softens on the right edge…",
                "style": {
                  "fontSize": 15,
                  "fontWeight": 600,
                  "color": "#ffffff",
                  "textTransform": "capitalize"
                }
              }
            ]
          },

          {
            "type": "text",
            "id": "h_filter",
            "text": "4. CSS filter stack (QSS + qs)",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "filter_row",
            "style": { "gap": 12 },
            "children": [
              {
                "type": "box",
                "id": "filter_card",
                "class": "filterCard",
                "children": [
                  {
                    "type": "text",
                    "text": "{{ state.filterOn ? \"filtered\" : \"raw\" }}",
                    "style": {
                      "fontSize": 16,
                      "fontWeight": 700,
                      "color": "#ffffff",
                      "textTransform": "uppercase"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "id": "btn_filter",
                "text": "Toggle filter",
                "class": "springBtn",
                "onPress": { "type": "invoke", "name": "toggle_filter" },
                "style": { "background": "#2c3344" }
              }
            ]
          },

          {
            "type": "text",
            "id": "h_blend",
            "text": "5. Mix-blend-mode",
            "class": "heading"
          },
          {
            "type": "box",
            "id": "blend_stage",
            "style": {
              "width": "fill",
              "height": 100,
              "borderRadius": 12,
              "background": "#1c7c54",
              "padding": 0
            },
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "box",
                "id": "blend_overlay",
                "style": {
                  "width": 140,
                  "height": 70,
                  "x": 40,
                  "y": 15,
                  "borderRadius": 10,
                  "background": "#ff9f0a",
                  "mixBlendMode": "{{ state.blendOn ? \"multiply\" : \"normal\" }}",
                  "padding": 10
                },
                "children": [
                  {
                    "type": "text",
                    "text": "multiply",
                    "style": { "fontSize": 13, "fontWeight": 700, "color": "#1d1d1f" }
                  }
                ]
              }
            ]
          },
          {
            "type": "button",
            "id": "btn_blend",
            "text": "Toggle blend",
            "class": "springBtn",
            "onPress": { "type": "invoke", "name": "toggle_blend" },
            "style": { "background": "#2c3344" }
          },

          {
            "type": "text",
            "id": "h_flip",
            "text": "6. FLIP layout motion (QSS + qs)",
            "class": "heading"
          },
          {
            "type": "box",
            "id": "flip_stage",
            "style": {
              "width": "fill",
              "height": 80,
              "borderRadius": 12,
              "background": "#1a1f2b"
            },
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "box",
                "id": "flip_chip",
                "class": "flipChip",
                "children": [
                  {
                    "type": "text",
                    "text": "GO",
                    "style": {
                      "fontSize": 14,
                      "fontWeight": 800,
                      "color": "#ffffff",
                      "textAlign": "center"
                    }
                  }
                ]
              }
            ]
          },
          {
            "type": "button",
            "id": "btn_flip",
            "text": "Move chip (FLIP)",
            "class": "springBtn",
            "onPress": { "type": "invoke", "name": "toggle_flip" },
            "style": { "background": "#0a84ff" }
          },

          {
            "type": "text",
            "id": "h_clip",
            "text": "7. clip-path circle / inset",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "clip_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "clip_circle",
                "class": "clipCircle",
                "children": [
                  {
                    "type": "text",
                    "text": "circle",
                    "style": { "fontSize": 13, "fontWeight": 700, "color": "#ffffff", "textAlign": "center" }
                  }
                ]
              },
              {
                "type": "box",
                "id": "clip_inset",
                "class": "clipInset",
                "children": [
                  {
                    "type": "text",
                    "text": "inset round",
                    "style": { "fontSize": 12, "fontWeight": 700, "color": "#0a1a0a" }
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_cache",
            "text": "8. layerCache (static blur reuse)",
            "class": "heading"
          },
          {
            "type": "box",
            "id": "cache_blur",
            "class": "cacheBlur",
            "style": { "width": 328 },
            "children": [
              {
                "type": "text",
                "text": "Blurred panel with layerCache — steady frames skip re-raster of this subtree",
                "style": { "fontSize": 12, "fontWeight": 600, "color": "#ffffff", "lineClamp": 2 }
              }
            ]
          },

          {
            "type": "text",
            "id": "h_gamefx",
            "text": "9. Game FX (DOTween / Phaser-style)",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "gamefx_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "game_sprite",
                "fx": "{{ state.fxMode }}",
                "fxToken": "{{ state.hits }}",
                "fxDuration": 360,
                "fxIntensity": 12,
                "style": {
                  "width": 72,
                  "height": 72,
                  "borderRadius": 16,
                  "background": "linear-gradient(135deg, #ff375f, #ff9f0a)",
                  "padding": 12
                },
                "children": [
                  {
                    "type": "text",
                    "text": "HP",
                    "style": {
                      "fontSize": 18,
                      "fontWeight": 800,
                      "color": "#ffffff",
                      "textAlign": "center"
                    }
                  }
                ]
              },
              {
                "type": "column",
                "style": { "gap": 8, "flexGrow": 1 },
                "children": [
                  {
                    "type": "text",
                    "text": "hits: {{ state.hits }} · fx: {{ state.fxMode }}",
                    "style": { "fontSize": 13, "color": "#9aa3b2" }
                  },
                  {
                    "type": "row",
                    "style": { "gap": 6 },
                    "children": [
                      {
                        "type": "button",
                        "id": "btn_hit",
                        "text": "Hit",
                        "class": "springBtn",
                        "onPress": { "type": "invoke", "name": "fire_hit" },
                        "style": { "background": "#ff375f", "padding": 8 }
                      },
                      {
                        "type": "button",
                        "id": "btn_shake",
                        "text": "Shake",
                        "class": "springBtn",
                        "onPress": { "type": "invoke", "name": "set_fx_shake" },
                        "style": { "background": "#2c3344", "padding": 8 }
                      }
                    ]
                  },
                  {
                    "type": "row",
                    "style": { "gap": 6 },
                    "children": [
                      {
                        "type": "button",
                        "id": "btn_punch",
                        "text": "Punch",
                        "class": "springBtn",
                        "onPress": { "type": "invoke", "name": "set_fx_punch" },
                        "style": { "background": "#2c3344", "padding": 8 }
                      },
                      {
                        "type": "button",
                        "id": "btn_float",
                        "text": "Float",
                        "class": "springBtn",
                        "onPress": { "type": "invoke", "name": "set_fx_float" },
                        "style": { "background": "#0a84ff", "padding": 8 }
                      }
                    ]
                  },
                  {
                    "type": "button",
                    "id": "btn_burst",
                    "text": "Burst",
                    "class": "springBtn",
                    "onPress": { "type": "invoke", "name": "set_fx_burst" },
                    "style": { "background": "#ff9f0a", "padding": 8, "color": "#1d1d1f" }
                  }
                ]
              }
            ]
          },
          {
            "type": "row",
            "id": "gamefx_more",
            "style": { "gap": 6, "width": "fill" },
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "button",
                "id": "btn_flash",
                "text": "Flash",
                "class": "springBtn",
                "onPress": { "type": "invoke", "name": "set_fx_flash" },
                "style": { "background": "#ffd60a", "padding": 8, "color": "#1d1d1f", "flexGrow": 1 }
              },
              {
                "type": "button",
                "id": "btn_wobble",
                "text": "Wobble",
                "class": "springBtn",
                "onPress": { "type": "invoke", "name": "set_fx_wobble" },
                "style": { "background": "#bf5af2", "padding": 8, "flexGrow": 1 }
              },
              {
                "type": "button",
                "id": "btn_knockback",
                "text": "Knockback",
                "class": "springBtn",
                "onPress": { "type": "invoke", "name": "set_fx_knockback" },
                "style": { "background": "#ff375f", "padding": 8, "flexGrow": 1 }
              }
            ]
          },

          {
            "type": "text",
            "id": "h_timeline",
            "text": "10. Timeline sequence + onComplete",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "timeline_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "tl_sprite",
                "timeline": [
                  { "scale": 1.35, "duration": 180, "ease": "backOut" },
                  { "dx": 56, "dy": -6, "duration": 220, "ease": "easeOut", "parallel": true },
                  { "wait": 80 },
                  { "scale": 1, "dx": 0, "dy": 0, "duration": 240, "ease": "easeInOut" }
                ],
                "timelineToken": "{{ state.tlPlay }}",
                "timelineOnComplete": "timeline_done",
                "style": {
                  "width": 64,
                  "height": 64,
                  "borderRadius": 14,
                  "background": "linear-gradient(135deg, #5e5ce6, #0a84ff)",
                  "padding": 10
                },
                "children": [
                  {
                    "type": "text",
                    "text": "SEQ",
                    "style": {
                      "fontSize": 14,
                      "fontWeight": 800,
                      "color": "#ffffff",
                      "textAlign": "center"
                    }
                  }
                ]
              },
              {
                "type": "column",
                "style": { "gap": 8, "flexGrow": 1 },
                "children": [
                  {
                    "type": "text",
                    "text": "plays: {{ state.tlPlay }} · done: {{ state.tlDone }}",
                    "style": { "fontSize": 12, "color": "#9aa3b2", "lineClamp": 2, "width": 220 }
                  },
                  {
                    "type": "button",
                    "id": "btn_timeline",
                    "text": "Play sequence",
                    "class": "springBtn",
                    "onPress": { "type": "invoke", "name": "play_timeline" },
                    "style": { "background": "#5e5ce6", "padding": 10 }
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_path",
            "text": "11. Path follow (DOPath / Path2D)",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "path_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "path_stage",
                "style": {
                  "width": 200,
                  "height": 90,
                  "borderRadius": 12,
                  "background": "#1a1f2b"
                },
                "children": [
                  {
                    "type": "box",
                    "id": "path_dot",
                    "timeline": [
                      {
                        "path": [[0, 20], [60, -10], [120, 30], [160, 10]],
                        "duration": 700,
                        "ease": "easeInOut",
                        "orient": true
                      },
                      { "path": [[160, 10], [0, 20]], "duration": 500, "ease": "sineInOut" }
                    ],
                    "timelineToken": "{{ state.pathPlay }}",
                    "style": {
                      "width": 28,
                      "height": 28,
                      "borderRadius": 14,
                      "background": "#30d158"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "id": "btn_path",
                "text": "Play path",
                "class": "springBtn",
                "onPress": { "type": "invoke", "name": "play_path" },
                "style": { "background": "#30d158", "padding": 10, "color": "#0a1a0a" }
              }
            ]
          },

          {
            "type": "text",
            "id": "h_stagger",
            "text": "12. Stagger (list entrance)",
            "class": "heading"
          },
          {
            "type": "list",
            "id": "stagger_list",
            "data": "{{ state.staggerItems }}",
            "style": { "gap": 8 },
            "layout": { "orientation": "horizontal" },
            "renderItem": {
              "type": "box",
              "animation": "fadeup",
              "duration": 420,
              "curve": "backOut",
              "stagger": 80,
              "style": {
                "width": 40,
                "height": 40,
                "borderRadius": 10,
                "background": "{{ item.c }}"
              }
            }
          },

          {
            "type": "text",
            "id": "h_cubic",
            "text": "13. Cubic Bezier path",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "cubic_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "cubic_stage",
                "style": {
                  "width": 200,
                  "height": 80,
                  "borderRadius": 12,
                  "background": "#1a1f2b"
                },
                "children": [
                  {
                    "type": "box",
                    "id": "cubic_dot",
                    "timeline": [
                      {
                        "path": [[8, 40], [40, -20], [140, 90], [180, 30]],
                        "cubic": true,
                        "duration": 900,
                        "ease": "sineInOut",
                        "orient": true
                      }
                    ],
                    "timelineToken": "{{ state.cubicPlay }}",
                    "style": {
                      "width": 24,
                      "height": 24,
                      "borderRadius": 12,
                      "background": "#bf5af2"
                    }
                  }
                ]
              },
              {
                "type": "button",
                "id": "btn_cubic",
                "text": "Play cubic",
                "class": "springBtn",
                "onPress": { "type": "invoke", "name": "play_cubic" },
                "style": { "background": "#bf5af2", "padding": 10 }
              }
            ]
          },

          {
            "type": "text",
            "id": "h_yoyo",
            "text": "14. Yoyo (style + timeline)",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "yoyo_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "yoyo_style",
                "style": {
                  "width": 56,
                  "height": 56,
                  "borderRadius": 12,
                  "background": "#af52de",
                  "opacity": "{{ state.yoyoOn ? 0.3 : 1 }}",
                  "transition": "0.35s",
                  "transitionEasing": "sineInOut",
                  "transitionYoyo": true,
                  "transitionRepeat": 1
                }
              },
              {
                "type": "box",
                "id": "yoyo_tl",
                "timeline": {
                  "yoyo": true,
                  "repeat": 1,
                  "steps": [
                    { "scale": 1.4, "dx": 36, "duration": 280, "ease": "easeOut" }
                  ]
                },
                "timelineToken": "{{ state.yoyoTl }}",
                "style": {
                  "width": 48,
                  "height": 48,
                  "borderRadius": 10,
                  "background": "#64d2ff"
                }
              },
              {
                "type": "column",
                "style": { "gap": 8 },
                "children": [
                  {
                    "type": "button",
                    "id": "btn_yoyo_style",
                    "text": "Style yoyo",
                    "class": "springBtn",
                    "onPress": { "type": "invoke", "name": "toggle_yoyo" },
                    "style": { "background": "#af52de", "padding": 10 }
                  },
                  {
                    "type": "button",
                    "id": "btn_yoyo_tl",
                    "text": "Timeline yoyo",
                    "class": "springBtn",
                    "onPress": { "type": "invoke", "name": "play_yoyo_tl" },
                    "style": { "background": "#64d2ff", "padding": 10, "color": "#0a1a2a" }
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_text",
            "text": "15. Text chrome (stroke / shadow)",
            "class": "heading"
          },
          {
            "type": "column",
            "id": "text_chrome_block",
            "style": { "gap": 10, "width": "fill" },
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "text",
                "id": "text_chrome",
                "text": "stroke",
                "class": "textChrome"
              },
              {
                "type": "text",
                "id": "ellipsis_line",
                "text": "A very long caption that should ellipsis when the line is too narrow for this card",
                "class": "ellipsisLine"
              },
              {
                "type": "box",
                "id": "clamp_box",
                "style": { "width": 220 },
                "children": [
                  {
                    "type": "text",
                    "id": "clamp_copy",
                    "text": "Two-line clamp: this paragraph is long enough to wrap past two lines so the last visible line ends with an ellipsis instead of spilling down the stage.",
                    "class": "clampCopy"
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_inset",
            "text": "16. Inset shadow + outline ring",
            "class": "heading"
          },
          {
            "type": "row",
            "id": "inset_row",
            "style": { "gap": 16 },
            "layout": { "align": "center" },
            "children": [
              {
                "type": "box",
                "id": "inset_shadow",
                "class": "insetShadow",
                "children": [
                  {
                    "type": "text",
                    "text": "inset + ring",
                    "style": { "fontSize": 13, "fontWeight": 700, "color": "#e8ecf4" }
                  }
                ]
              },
              {
                "type": "box",
                "id": "overflow_clip",
                "class": "overflowClip",
                "children": [
                  {
                    "type": "box",
                    "id": "overflow_child",
                    "style": {
                      "width": 90,
                      "height": 90,
                      "x": 56,
                      "y": 24,
                      "borderRadius": 8,
                      "background": "#ff375f"
                    }
                  }
                ]
              }
            ]
          },

          {
            "type": "text",
            "id": "h_frost",
            "text": "17. Backdrop frost",
            "class": "heading"
          },
          {
            "type": "box",
            "id": "frost_stage",
            "style": {
              "width": "fill",
              "height": 132,
              "borderRadius": 16,
              "overflow": "hidden",
              "background": "linear-gradient(90deg, #ff375f, #ff9f0a, #30d158, #0a84ff, #bf5af2)"
            },
            "layout": { "width": "fill" },
            "children": [
              {
                "type": "row",
