{
  "type": "scene",
  "id": "main",
  "onEnter": "restart",
  "keys": {
    "left": "moveLeft",
    "right": "moveRight",
    "a": "moveLeft",
    "d": "moveRight",
    "up": "jump",
    "w": "jump",
    "space": "jump",
    "shift": "runOn",
    "r": "restart"
  },
  "keyReleases": {
    "left": "stopLeft",
    "right": "stopRight",
    "a": "stopLeft",
    "d": "stopRight",
    "up": "stopJump",
    "w": "stopJump",
    "space": "stopJump",
    "shift": "runOff",
    "r": "restartArm"
  },
  "swipes": {
    "up": "jump"
  },
  "root": {
    "type": "stack",
    "id": "root",
    "style": {
      "width": 512,
      "height": 480,
      "background": "#000000"
    },
    "children": [
      {
        "type": "board",
        "id": "world",
        "style": {
          "background": "var(--sky)",
          "width": 512,
          "height": 480
        },
        "cameraTarget": "{{state.mario}}",
        "cameraCenter": "x",
        "cameraCell": 32,
        "cameraViewport": 16,
        "cameraDeadZone": 160,
        "cameraLockLeft": true,
        "cameraResetToken": "{{state.cameraGen}}",
        "cameraMax": {
          "x": 6240
        },
        "disablePan": true,
        "children": [
          {
            "type": "timer",
            "id": "physics",
            "every": 16,
            "onTick": "tick",
            "if": "{{ state.status == 'playing' || (state.status == 'dead' && !state.deathDone) }}"
          },
          {
            "type": "tilemap",
            "id": "tiles",
            "rows": "{{state.rows}}",
            "cell": 32,
            "bumpX": "{{state.bumpCX}}",
            "bumpY": "{{state.bumpCY}}",
            "bumpT": "{{state.bumpT}}",
            "atlas": {
              "1": "assets/ground.png",
              "2": "assets/brick.png",
              "3": "assets/coin.png",
              "4": "assets/flag.png",
              "5": "assets/pipe_top.png",
              "6": "assets/pipe_body.png",
              "7": "assets/question.png",
              "q": "assets/question.png",
              "8": "assets/used.png",
              "b": "assets/stair.png",
              "c": "assets/castle.png",
              "d": "assets/cloud.png",
              "e": "assets/bush.png",
              "h": "assets/hill.png"
            },
            "style": {
              "x": 0,
              "y": 0
            }
          },
          {
            "type": "image",
            "id": "mario",
            "src": "{{ !state.mario.alive || !state.mario.onGround ? (state.mario.big ? \"assets/mario_big_jump.png\" : \"assets/mario_jump.png\") : (state.mario.walkPhase > 3 && state.mario.walkPhase < 12 ? (state.mario.big ? \"assets/mario_big_walk.png\" : \"assets/mario_walk.png\") : (state.mario.big ? \"assets/mario_big.png\" : \"assets/mario.png\")) }}",
            "if": "{{ state.mario.invuln == 0 || mod(state.mario.invuln, 8) < 4 }}",
            "fit": "fill",
            "style": {
              "x": "{{ state.mario.x - 4 }}",
              "y": "{{ state.mario.y }}",
              "width": 32,
              "height": "{{ state.mario.big ? 64 : 32 }}",
              "flipX": "{{ state.mario.dir < 0 }}",
              "imageRendering": "pixelated"
            }
          },
          {
            "type": "list",
            "id": "goombas",
            "data": "{{state.goombas}}",
            "as": "g",
            "renderItem": {
              "type": "image",
              "id": "goomba",
              "src": "{{ g.walkPhase > 7 ? \"assets/goomba_walk.png\" : \"assets/goomba.png\" }}",
              "if": "{{g.alive}}",
              "style": {
                "x": "{{g.x}}",
                "y": "{{ g.squash > 0 ? g.y + 16 : g.y }}",
                "width": 32,
                "height": "{{ g.squash > 0 ? 16 : 32 }}",
                "flipX": "{{ g.vx > 0 }}"
              }
            }
          },
          {
            "type": "list",
            "id": "powerups",
            "data": "{{state.powerups}}",
            "as": "p",
            "renderItem": {
              "type": "image",
              "id": "powerup",
              "src": "assets/mushroom.png",
              "if": "{{p.alive}}",
              "style": {
                "x": "{{p.x}}",
                "y": "{{p.y}}",
                "width": 32,
                "height": 32
              }
            }
          }
        ]
      },
      {
        "type": "row",
        "id": "hud",
        "style": {
          "x": 0,
          "y": 0,
          "width": 512,
          "height": 40,
          "padding": 6,
          "gap": 24
        },
        "children": [
          {
            "type": "column",
            "style": { "gap": 0 },
            "children": [
              { "type": "text", "id": "hud-title", "text": "MARIO", "style": { "fontSize": 11, "fontWeight": 800, "color": "#ffffff", "letterSpacing": 1 } },
              { "type": "text", "id": "hud-score-value", "text": "{{ state.score }}", "style": { "fontSize": 13, "fontWeight": 700, "color": "#ffffff" } }
            ]
          },
          {
            "type": "column",
            "style": { "gap": 0 },
            "children": [
              { "type": "text", "id": "hud-coin-label", "text": "COIN", "style": { "fontSize": 11, "fontWeight": 800, "color": "#ffffff" } },
              { "type": "text", "id": "hud-coin-value", "text": "x{{ state.coins }}", "style": { "fontSize": 13, "fontWeight": 700, "color": "#f8d878" } }
            ]
          },
          {
            "type": "column",
            "style": { "gap": 0 },
            "children": [
              { "type": "text", "id": "hud-world-label", "text": "WORLD", "style": { "fontSize": 11, "fontWeight": 800, "color": "#ffffff" } },
              { "type": "text", "id": "hud-world-value", "text": "1-1", "style": { "fontSize": 13, "fontWeight": 700, "color": "#ffffff" } }
            ]
          },
          {
            "type": "column",
            "style": { "gap": 0 },
            "children": [
              { "type": "text", "id": "hud-time-label", "text": "TIME", "style": { "fontSize": 11, "fontWeight": 800, "color": "#ffffff" } },
              { "type": "text", "id": "hud-time-value", "text": "{{ floor(state.timeLeft) }}", "style": { "fontSize": 13, "fontWeight": 700, "color": "#ffffff" } }
            ]
          }
        ]
      },
      {
        "type": "column",
        "id": "deadOverlay",
        "if": "{{ state.status == 'dead' && state.deathDone }}",
        "animation": "pop",
        "duration": 420,
        "curve": "backOut",
        "style": {
          "x": 160,
          "y": 176,
          "width": 192,
          "height": 100,
          "background": "#000000cc",
          "borderRadius": 4,
          "padding": 12,
          "gap": 6
        },
        "children": [
          { "type": "text", "text": "GAME OVER", "style": { "fontSize": 16, "fontWeight": 800, "color": "#ffffff", "textAlign": "center" } },
          { "type": "text", "text": "PRESS R", "style": { "fontSize": 11, "color": "#cccccc", "textAlign": "center" } }
        ]
      },
      {
        "type": "column",
        "id": "wonOverlay",
        "if": "{{ state.status == 'won' }}",
        "animation": "pop",
        "duration": 420,
        "curve": "backOut",
        "style": {
          "x": 160,
          "y": 176,
          "width": 192,
          "height": 100,
          "background": "#000000cc",
          "borderRadius": 4,
          "padding": 12,
          "gap": 6
        },
        "children": [
          { "type": "text", "text": "COURSE CLEAR", "style": { "fontSize": 16, "fontWeight": 800, "color": "#ffffff", "textAlign": "center" } },
          { "type": "text", "text": "PRESS R", "style": { "fontSize": 11, "color": "#cccccc", "textAlign": "center" } }
        ]
      }
    ]
  }
}