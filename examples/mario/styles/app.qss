# Mario 共享样式 —— DOM+CSS+JS 三层分离的样式层:
# 结构在 scenes/*.json,逻辑在 actions/*.qs,通用样式集中在这里,
# 场景节点经 class 引用(后者覆盖前者,id 规则与行内 style 优先级更高)。

# SCORE / COINS 小标题
.statLabel { color: var(--text); fontSize: 11; fontWeight: 700 }

# SCORE / COINS 数值
.statValue { color: var(--coin); fontSize: 16; fontWeight: 700 }

# 记分牌底板(包裹一对 label+value;padding 留在场景行内 —— HTML 端只认行内样式)
.scoreBox { background: var(--mario); borderRadius: 6; gap: 2 }

# 重新开始按钮(手机端没有 R 键 —— 与记分牌同高的紧凑按钮)
.restartBtn { background: var(--mario); color: var(--text); borderRadius: 6; fontSize: 13; fontWeight: 700; padding: 8 }

# 屏幕触控按钮(◀ / JUMP / ▶ —— 手机上除滑动外的精确操控)
.controlBtn { background: var(--mario); color: var(--text); borderRadius: 8; fontSize: 15; fontWeight: 700; padding: 10; width: 72 }

# 底部操作说明
.helpText { color: var(--text); fontSize: 12; textAlign: center }

# 胜利 / 结束覆盖层面板(padding/margin 是嵌套对象,留在场景行内)
.overlayPanel { background: var(--mario); borderRadius: 8; gap: 2 }

# 覆盖层标题(COURSE CLEAR! / GAME OVER)
.overlayTitle { color: var(--text); fontSize: 15; fontWeight: 700 }

# 覆盖层提示行
.overlayHint { color: var(--text); fontSize: 10 }
