{
  "qorm": "0.1",
  "type": "test",
  "id": "fixture_pass",
  "scene": "scene://main",
  "steps": [
    { "type": "set_state", "path": "count", "value": 1 },
    { "type": "simulate_event", "target": { "id": "btn_increment" }, "event": "press" },
    { "type": "simulate_event", "action": "set_status", "args": { "msg": "Fresh" } }
  ],
  "assert": [
    { "type": "state_equals", "path": "count", "value": 2 },
    { "type": "state_equals", "path": "status", "value": "Fresh" },
    { "type": "node_exists", "target": { "id": "btn_increment" } },
    { "type": "node_exists", "target": { "type": "button" } },
    { "type": "node_not_exists", "target": { "id": "absent_node" } },
    { "type": "node_not_exists", "target": { "id": "hidden_text" } },
    { "type": "text_equals", "target": { "id": "number" }, "value": "2" },
    { "type": "text_equals", "target": { "id": "status_text" }, "value": "Fresh" },
    { "type": "prop_equals", "target": { "id": "btn_increment" }, "prop": "label", "value": "Plus (2)" }
  ]
}